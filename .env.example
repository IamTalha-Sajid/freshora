MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/freshora
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@freshora.com
ADMIN_PASSWORD=change-me
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: order emails (store owner + customer) via https://resend.com. Leave blank to skip.
RESEND_API_KEY=
EMAIL_FROM=Freshora <orders@yourdomain.com>
ORDER_NOTIFY_EMAIL=

# Public site URL (used for og:image and canonical links), defaults to https://www.fresh-ora.store
NEXT_PUBLIC_SITE_URL=
